                        <img src="../dist/img/car-icon.png" alt="" class="icon car-icon">
                    </button>

                    <button aria-label="Usługi sprzątania" class="price__container-type-choice upholstery-price-btn"
                        data-target="sprzatanie-cennik">
                        <span class="desktop">Usługi sprzątania</span>
                        <span class="tablet">Sprzątanie</span>
                        <img src="../dist/img/sprzatanie-ikona.png" alt="" class="icon">
                    </button>

                    <button aria-label="Mycie ciśnieniowe" class="price__container-type-choice upholstery-price-btn"
                        data-target="cisnienie-cennik">
